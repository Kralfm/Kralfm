<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>❤️ Aşk FM</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #fff0f5, #f3e8ff);
      color: #222;
    }

    .container {
      max-width: 700px;
      margin: auto;
      padding: 25px 16px;
    }

    .header {
      background: white;
      border-radius: 25px;
      padding: 30px 20px;
      text-align: center;
      box-shadow: 0 8px 25px rgba(0,0,0,.10);
      margin-bottom: 20px;
    }

    .header h1 {
      margin: 0;
      font-size: 38px;
    }

    .header p {
      font-size: 18px;
      margin: 10px 0 0;
      color: #666;
    }

    .card {
      background: white;
      border-radius: 25px;
      padding: 22px;
      margin-bottom: 20px;
      box-shadow: 0 8px 25px rgba(0,0,0,.10);
    }

    .title {
      font-size: 27px;
      font-weight: bold;
      margin-bottom: 15px;
    }

    .radio {
      text-align: center;
    }

    audio {
      width: 100%;
      margin-top: 10px;
    }

    .buttons {
      display: flex;
      gap: 10px;
      margin-top: 15px;
    }

    button {
      flex: 1;
      border: 0;
      border-radius: 15px;
      padding: 13px;
      font-size: 16px;
      cursor: pointer;
      background: #e91e63;
      color: white;
    }

    button:hover {
      opacity: .9;
    }

    .chat {
      min-height: 400px;
      border-radius: 18px;
      overflow: hidden;
      background: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #777;
      padding: 20px;
    }

    .footer {
      text-align: center;
      color: #777;
      padding: 10px;
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="header">
      <h1>❤️ Aşk FM</h1>
      <p>7/24 Müzik • Şiir • Sohbet</p>
    </div>

    <div class="card radio">
      <div class="title">📻 Aşk FM</div>

      <p>🎧 Kral FM Yayını</p>

      <audio controls>
        <source src="RADYO_YAYIN_LINKI" type="audio/mpeg">
        Tarayıcınız ses oynatmayı desteklemiyor.
      </audio>

      <div class="buttons">
        <button onclick="document.querySelector('audio').play()">
          ▶️ Dinle
        </button>

        <button onclick="document.querySelector('audio').pause()">
          ⏸️ Durdur
        </button>
      </div>
    </div>

    <div class="card">
      <div class="title">💬 Aşk FM Sohbet</div>

      <div class="chat">
        <div>
          <div style="font-size:50px;">💬</div>
          <h3>Sohbet Odası</h3>
          <p>Birazdan sohbet sistemimizi buraya ekleyeceğiz 😊</p>
        </div>
      </div>
    </div>

    <div class="footer">
      ❤️ Aşk FM • Kral FM Muhabbet
    </div>

  </div>

</body>
</html>
